{
  "id": "openrouter-decisions",
  "name": "OpenRouter Decisions",
  "description": "Typed decision provider via OpenRouter's Decisions API (/api/alpha/decisions). decisionModels[].id are FULL OpenRouter model ids sent on the wire as-is - no hidden mapping. Tolerant of OpenRouter's extra response fields (id, provider, usage.cost).",
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "decisionProviders": [
      "openrouter-decisions"
    ]
  },
  "configContracts": {
    "secretInputs": {
      "bundledDefaultEnabled": false,
      "paths": [
        {
          "path": "apiKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "uiHints": {
    "apiKey": {
      "label": "OpenRouter API credential (optional when the proxy does not check auth)",
      "help": "SecretRef from Settings -> Secrets. Sent as Authorization: Bearer. Omit if your baseUrl proxy injects or does not require auth.",
      "sensitive": true
    },
    "baseUrl": {
      "label": "OpenRouter base URL",
      "help": "Optional - defaults to https://openrouter.ai. Any http(s) origin, optionally with a path prefix, e.g. a custom proxy http://127.0.0.1:8290. The provider POSTs {baseUrl}/api/alpha/decisions."
    },
    "timeoutMs": {
      "label": "Request timeout (ms)",
      "advanced": true
    }
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "source",
              "provider",
              "id"
            ],
            "properties": {
              "source": {
                "enum": [
                  "env",
                  "store",
                  "file",
                  "exec"
                ]
              },
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 120000,
        "default": 45000
      },
      "baseUrl": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^https?://[^\\s?#]+/?$"
      }
    },
    "additionalProperties": false
  },
  "decisionModels": [
